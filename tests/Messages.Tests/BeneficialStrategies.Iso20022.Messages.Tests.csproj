<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The same targets as the package, so each build is run and not only compiled. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <!-- .NET Framework 4.8 runs the netstandard2.0 build of the package; it needs Windows (CI has a job for it) -->
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('Windows')) Or '$(BuildNet48)' == 'true'">$(TargetFrameworks);net48</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>BeneficialStrategies.Iso20022</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.6.0" />
    <PackageReference Include="xunit" Version="2.4.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.4.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Only to show that the interfaces can be built by the Factory; the package itself does not use it. -->
    <PackageReference Include="BeneficialStrategies.Iso20022.Factory" Version="[1.0.0, 1.1.0)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Messages\BeneficialStrategies.Iso20022.Messages.csproj" />
  </ItemGroup>

  <!-- the tests use language and library features that .NET Framework lacks -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Polyfill" Version="11.*" PrivateAssets="all" />
  </ItemGroup>

</Project>
